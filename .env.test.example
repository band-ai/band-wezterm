# Local live-test configuration. Copy to `.env.test` and fill in credentials.
# `.env.test` is gitignored — never commit real keys.
#
# Loaded automatically by pytest (tests/conftest.py), same pattern as
# band-sdk-python and band-plugin-vsc.
#
# Opt-in live platform tests self-skip when BAND_API_KEY_USER is unset:
#   uv run pytest tests/integration/test_control_tab_pty.py -q
#
# Use the API host (api.dev), not the SPA host (platform.dev).

BAND_BASE_URL=https://api.dev.band.ai
BAND_REST_URL=https://api.dev.band.ai
BAND_WS_URL=wss://api.dev.band.ai/api/v1/socket/websocket

# User API key (owner) — drives live room/participant tests
BAND_API_KEY_USER=<your-user-api-key>

# Optional: pin a known agent instead of listing
# TEST_AGENT_ID=<agent-uuid>
# BAND_API_KEY=<your-agent-api-key>

# Product OAuth (Control tab sign-in) — separate from live API-key tests
# BAND_OAUTH_CLIENT_ID=<jam-public-client-id>
